# 正式环境敏感配置模板：复制为 .env 并填入强密钥（.env 已被 gitignore，禁止提交）
#   cp .env.example .env && vi .env

# PostgreSQL 密码（与已初始化数据库中的密码保持一致；新建库时由本变量初始化）
DB_PASSWORD=CHANGE_ME

# JWT 签名密钥：>=32 字节强随机值（更换会使已登录 token 全部失效）
# 生成：openssl rand -base64 48
DEPLOY_JWT_SECRET=CHANGE_ME

# 凭据 AES 加密主密钥：>=32 字节强随机值（更换会导致已加密的 SSH 凭据/LLM 密钥无法解密，
# 需先备份数据库再更换并重新录入凭据）
# 生成：openssl rand -base64 48
CREDENTIAL_KEK=CHANGE_ME

# admin 初始密码（仅首次种子化时生效）
DEPLOY_SEED_PASSWORD=CHANGE_ME
